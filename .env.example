# Executable names or absolute paths.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Resource and abuse controls.
DOWNLOAD_MAX_CONCURRENT=2
DOWNLOAD_MAX_PER_CLIENT=1
DOWNLOAD_MAX_REQUESTS_PER_HOUR=10
DOWNLOAD_MAX_FILESIZE=2G
DOWNLOAD_MAX_RUNTIME_SECONDS=1800
DOWNLOAD_INACTIVITY_SECONDS=120
DOWNLOAD_COMPLETED_TTL_SECONDS=900

# Defaults to the operating system temp directory.
# DOWNLOAD_TEMP_DIR=/var/tmp/authorized-youtube-downloader

# Only enable when the app is behind a trusted reverse proxy that replaces
# X-Forwarded-For. Never enable for a directly exposed server.
TRUST_PROXY=false

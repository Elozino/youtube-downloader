{
  "name": "authorized-youtube-downloader",
  "version": "1.0.0",
  "private": true,
  "description": "A self-hosted, permission-first YouTube download UI backed by yt-dlp and ffmpeg.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "start:mobile": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.18.3",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.3",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
